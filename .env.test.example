# Local PostgreSQL 18 migration test template.
# These values match packages/db/docker-compose.yml only.

MIGRATION_TARGET=local
NOTIFICATION_PUBLISHERS_ENABLED=false
DATABASE_URL=postgresql://migrator:migrator@localhost:5433/dayli_test
TEST_DATABASE_URL=postgresql://migrator:migrator@localhost:5433/dayli_test
TEST_APP_DATABASE_URL=postgresql://app:app@localhost:5433/dayli_test

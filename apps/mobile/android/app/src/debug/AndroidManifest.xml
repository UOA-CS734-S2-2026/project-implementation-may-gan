<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds trust a developer-installed user CA for Android platform
         HTTPS. Dart HTTP ignores it; see DAYLI_DEV_CA_PEM_B64 in
         docs/dayli/environments.md. Release builds do not include this
         override. -->
    <application android:networkSecurityConfig="@xml/debug_network_security_config"/>
</manifest>

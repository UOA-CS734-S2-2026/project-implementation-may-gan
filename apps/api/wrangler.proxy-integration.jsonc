{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayli-api-proxy-integration",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "API_RATE_LIMIT_SCOPE": "proxy-integration",
    "BETTER_AUTH_SECRET": "local-only-better-auth-secret-that-is-at-least-32-characters",
    "BETTER_AUTH_BASE_URL": "https://api.integration.test",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://api.integration.test,https://web.integration.test"
  },
  "ratelimits": [
    { "name": "API_INGRESS_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } },
    { "name": "API_READ_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "API_WRITE_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_MESSAGE_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "API_MEDIA_RATE_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_REALTIME_RATE_LIMIT", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_DIRECT_PUSH_RATE_LIMIT", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } }
  ],
  "services": [
    { "binding": "WEB_PROXY_FIXTURE", "service": "dayli-web-proxy-integration" }
  ]
}

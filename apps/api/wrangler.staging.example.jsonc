{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayli-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID"
    }
  ]
}

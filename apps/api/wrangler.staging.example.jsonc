{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayli-api-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": { "enabled": true },
  "ratelimits": [
    { "name": "API_INGRESS_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 1000, "period": 60 } },
    { "name": "API_READ_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 300, "period": 60 } },
    { "name": "API_WRITE_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_MESSAGE_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
    { "name": "API_MEDIA_RATE_LIMIT", "namespace_id": "1005", "simple": { "limit": 10, "period": 60 } },
    { "name": "API_REALTIME_RATE_LIMIT", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_DIRECT_PUSH_RATE_LIMIT", "namespace_id": "1007", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "API_RATE_LIMIT_SCOPE": "staging",
    "NOTIFICATION_PUBLISHERS_ENABLED": "false",
    "NOTIFICATION_DELIVERY_ENABLED": "false",
    "DIRECT_MESSAGE_SEND_LIMIT": "30",
    "BETTER_AUTH_BASE_URL": "https://api-staging.example.test",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://api-staging.example.test,https://web-staging.example.test",
    "R2_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "R2_BUCKET_NAME": "REPLACE_WITH_STAGING_R2_BUCKET_NAME"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_STAGING_HYPERDRIVE_ID"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "USER_REALTIME", "class_name": "UserRealtime" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserRealtime"] }],
  "triggers": { "crons": ["*/1 * * * *"] }
}

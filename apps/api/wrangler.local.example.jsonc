{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dayli-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "local-hyperdrive" }
  ]
}

# Deployment reference, not the normal localhost setup.
# For local development, pnpm local:auth:setup generates .env.local with
# NEXT_PUBLIC_API_BASE_URL=https://localhost:8787.
# Changing that local URL to staging does not enable staging browser sign-in.
# Use the deployed staging web app instead.
# Exact HTTPS staging API origin, without a trailing slash. In direct mode,
# browser calls send the Better Auth session cookie, so the API must trust the
# deployed web origin. Replace these non-routable examples in approved build
# configuration. NEXT_PUBLIC_ values are public and must never hold secrets.
NEXT_PUBLIC_API_BASE_URL=https://api.staging.example.test

# Keep false until the private binding, source-identity proof, and browser
# reauthentication cutover are approved. When true, browser REST and Better
# Auth use this exact web origin. Mobile and WebSocket ticket URLs still use
# NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_WEB_API_PROXY_ENABLED=false
NEXT_PUBLIC_WEB_API_BASE_URL=https://web.staging.example.test

{
  "openapi": "3.1.0",
  "info": {
    "title": "Dayli API",
    "version": "1.0.0",
    "description": "REST API shared by the Dayli mobile and web clients."
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Dayli session token"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "dayli-api"
            ]
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "TestResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": [
              "Dayli API contracts are available."
            ]
          },
          "timestamp": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "aucklandDate": {
            "$ref": "#/components/schemas/AucklandDate"
          },
          "requestedLimit": {
            "type": "integer"
          }
        },
        "required": [
          "message",
          "timestamp",
          "aucklandDate",
          "requestedLimit"
        ]
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "example": "2026-09-09T12:00:00Z"
      },
      "AucklandDate": {
        "type": "string",
        "format": "date",
        "example": "2026-09-10"
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ApiErrorCode"
              },
              "message": {
                "type": "string",
                "example": "The request could not be completed."
              },
              "requestId": {
                "type": "string",
                "example": "req_01K4Y6P8K2"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "VALIDATION_FAILED",
          "RATE_LIMITED",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE"
        ]
      },
      "CurrentPostingDayResponse": {
        "type": "object",
        "properties": {
          "serverNow": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "localDate": {
            "$ref": "#/components/schemas/AucklandDate"
          },
          "deadlineAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "releaseAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "prompt": {
            "$ref": "#/components/schemas/DailyPromptResponse"
          },
          "hasPosted": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "serverNow",
          "localDate",
          "deadlineAt",
          "releaseAt",
          "prompt",
          "hasPosted"
        ]
      },
      "DailyPromptResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "example": "prompt-09-22"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "example": "What made you smile today?"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "system.health",
        "summary": "Check API availability",
        "responses": {
          "200": {
            "description": "The API is available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/test": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "system.testContracts",
        "summary": "Exercise common API contracts",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque continuation cursor"
            },
            "required": false,
            "description": "Opaque continuation cursor",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Representative date, time, and pagination values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResponse"
                }
              }
            }
          },
          "422": {
            "description": "The query parameters are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posting-days/current": {
      "get": {
        "tags": [
          "Posting Days"
        ],
        "operationId": "postingDays.current",
        "summary": "Read the current Auckland posting day",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The server-owned current posting day and scheduled prompt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentPostingDayResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "The prompt or posting-state dependency is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}

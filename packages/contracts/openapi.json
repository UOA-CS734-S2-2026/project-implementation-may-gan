    "/api/v1/relationships/requests/{requestId}/cancel": {
      "post": {
        "tags": [
          "Relationships"
        ],
        "operationId": "relationships.cancelRequest",
        "summary": "Cancel a pending relationship request",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            },
            "required": true,
            "name": "requestId",
            "in": "path"
          }
        ],
        "responses": {

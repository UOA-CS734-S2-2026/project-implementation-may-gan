{
  "openapi": "3.1.0",
  "info": {
    "title": "Dayli API",
    "version": "1.0.0",
    "description": "REST API shared by the Dayli mobile and web clients."
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Dayli session token"
      },
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Browser clients may authenticate with the Better Auth secure session cookie."
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "dayli-api"
            ]
          }
        },
        "required": [
          "status",
          "service"
        ]
      },
      "TestResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "enum": [
              "Dayli API contracts are available."
            ]
          },
          "timestamp": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "aucklandDate": {
            "$ref": "#/components/schemas/AucklandDate"
          },
          "requestedLimit": {
            "type": "integer"
          }
        },
        "required": [
          "message",
          "timestamp",
          "aucklandDate",
          "requestedLimit"
        ]
      },
      "UtcTimestamp": {
        "type": "string",
        "format": "date-time",
        "example": "2026-09-09T12:00:00Z"
      },
      "AucklandDate": {
        "type": "string",
        "format": "date",
        "example": "2026-09-10"
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ApiErrorCode"
              },
              "message": {
                "type": "string",
                "example": "The request could not be completed."
              },
              "requestId": {
                "type": "string",
                "example": "req_01K4Y6P8K2"
              },
              "details": {
                "type": "object",
                "additionalProperties": {
                  "nullable": true
                }
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "BAD_REQUEST",
          "UNAUTHENTICATED",
          "FORBIDDEN",
          "NOT_FOUND",
          "CONFLICT",
          "VALIDATION_FAILED",
          "RATE_LIMITED",
          "INTERNAL_ERROR",
          "SERVICE_UNAVAILABLE"
        ]
      },
      "CreateMediaReservationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "contentType": {
            "$ref": "#/components/schemas/MediaContentType"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "status": {
            "$ref": "#/components/schemas/MediaReservationStatus"
          },
          "createdAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "upload": {
            "$ref": "#/components/schemas/MediaReservationUpload"
          }
        },
        "required": [
          "id",
          "contentType",
          "byteSize",
          "status",
          "createdAt",
          "expiresAt",
          "upload"
        ]
      },
      "OpaqueId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "example": "post_01K4Y6P8K2"
      },
      "MediaContentType": {
        "type": "string",
        "enum": [
          "image/jpeg",
          "image/png",
          "image/webp",
          "image/heic",
          "video/mp4",
          "video/quicktime"
        ]
      },
      "MediaReservationStatus": {
        "type": "string",
        "enum": [
          "pending",
          "expired"
        ]
      },
      "MediaReservationUpload": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "method": {
            "type": "string",
            "enum": [
              "PUT"
            ]
          },
          "requiredHeaders": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "url",
          "method",
          "requiredHeaders"
        ]
      },
      "CreateMediaReservationRequest": {
        "type": "object",
        "properties": {
          "contentType": {
            "$ref": "#/components/schemas/MediaContentType"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 10485760
          }
        },
        "required": [
          "contentType",
          "byteSize"
        ]
      },
      "MediaReservation": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/OpaqueId"
          },
          "contentType": {
            "$ref": "#/components/schemas/MediaContentType"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true
          },
          "status": {
            "$ref": "#/components/schemas/MediaReservationStatus"
          },
          "createdAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "expiresAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          }
        },
        "required": [
          "id",
          "contentType",
          "byteSize",
          "status",
          "createdAt",
          "expiresAt"
        ]
      },
      "CurrentPostingDayResponse": {
        "type": "object",
        "properties": {
          "serverNow": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "localDate": {
            "$ref": "#/components/schemas/AucklandDate"
          },
          "deadlineAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "releaseAt": {
            "$ref": "#/components/schemas/UtcTimestamp"
          },
          "prompt": {
            "$ref": "#/components/schemas/DailyPromptResponse"
          },
          "hasPosted": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "serverNow",
          "localDate",
          "deadlineAt",
          "releaseAt",
          "prompt",
          "hasPosted"
        ]
      },
      "DailyPromptResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "example": "prompt-09-22"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "example": "What made you smile today?"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "system.health",
        "summary": "Check API availability",
        "responses": {
          "200": {
            "description": "The API is available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/test": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "system.testContracts",
        "summary": "Exercise common API contracts",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Opaque continuation cursor"
            },
            "required": false,
            "description": "Opaque continuation cursor",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Representative date, time, and pagination values.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TestResponse"
                }
              }
            }
          },
          "422": {
            "description": "The query parameters are invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media-reservations": {
      "post": {
        "tags": [
          "Media"
        ],
        "operationId": "media.reservations.create",
        "summary": "Reserve an opaque, owned R2 object path for a direct upload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMediaReservationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The reservation and a short-lived, single-object presigned upload URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateMediaReservationResponse"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "422": {
            "description": "The request body is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "Too many pending reservations for this owner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Media reservations are not currently configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media-reservations/{id}": {
      "get": {
        "tags": [
          "Media"
        ],
        "operationId": "media.reservations.get",
        "summary": "Read the caller's own media reservation",
        "parameters": [
          {
            "schema": {
              "$ref": "#/components/schemas/OpaqueId"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The reservation's current state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MediaReservation"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "No reservation with that id owned by the caller.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Media reservations are not currently configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posting-days/current": {
      "get": {
        "tags": [
          "Posting Days"
        ],
        "operationId": "postingDays.current",
        "summary": "Read the current Auckland posting day",
        "security": [
          {
            "BearerAuth": []
          },
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The server-owned current posting day and scheduled prompt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentPostingDayResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication is required.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "The prompt or posting-state dependency is temporarily unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  }
}

# Safe repository template. Replace locally or in protected GitHub environments.
# Never commit real usernames, passwords, hosts, project IDs, or connection strings.

# Worker auth configuration, set BETTER_AUTH_SECRET through `wrangler secret put`.
# Use only exact HTTPS origins, comma separated. HYPERDRIVE is a Worker binding, not a variable.
BETTER_AUTH_BASE_URL=https://api.example.test
BETTER_AUTH_TRUSTED_ORIGINS=https://api.example.test,https://web.example.test

MIGRATION_TARGET=staging
DATABASE_URL=postgresql://migrator:<password>@<project-branch>.<region>.aws.neon.tech/<database>?sslmode=require
# Dedicated legacy Supabase role with CONNECT and SELECT only. Used only for aggregate migration inventory.
LEGACY_SUPABASE_READONLY_DATABASE_URL=postgresql://inventory_reader:<password>@<project>.supabase.co/postgres?sslmode=require
CONFIRM_PRODUCTION_MIGRATION=
CONFIRM_NEON_BACKUP_CHECKED=

# Safe repository template. Replace locally or in protected GitHub environments.
# Never commit real usernames, passwords, hosts, project IDs, or connection strings.

# Worker auth configuration. Generate a random secret of at least 32 characters.
# Supply secrets through ignored apps/api/.dev.vars locally or `wrangler secret put` remotely.
# This root template is not automatically loaded into Worker bindings.
# Use only exact HTTPS origins, comma separated. HYPERDRIVE is a Worker binding, not a variable.
BETTER_AUTH_SECRET=
BETTER_AUTH_BASE_URL=https://api.example.test
BETTER_AUTH_TRUSTED_ORIGINS=https://api.example.test,https://web.example.test

# Google OAuth. Auth mounts only when all Google values below are present and valid.
# Register the web callback: https://api.example.test/api/auth/callback/google
# GOOGLE_CLIENT_SECRET is a Worker secret. The client IDs are public Worker vars.
# The web client ID is the primary redirect-flow audience. iOS and Android IDs are accepted only for native ID tokens.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Resend transactional authentication email. Both values enable delivery. A partial pair keeps auth unmounted.
# Verify the sending domain and its required DNS records before enabling delivery.
# RESEND_API_KEY is a Worker secret. RESEND_FROM is a public Worker var.
RESEND_API_KEY=
RESEND_FROM="Dayli <auth@example.test>"

# Web build settings. Browser proxy mode stays false until the binding, source
# identity proof, and reauthentication cutover are approved.
NEXT_PUBLIC_API_BASE_URL=https://api.example.test
NEXT_PUBLIC_WEB_API_PROXY_ENABLED=false
NEXT_PUBLIC_WEB_API_BASE_URL=https://web.example.test

# Direct public API origin. Keep it separate from BETTER_AUTH_BASE_URL when
# Better Auth moves to the web origin. Native bearer sessions and ticket
# WebSockets continue to use this origin.
PUBLIC_API_BASE_URL=https://api.example.test

# Schema migrations only. Never supply this direct migrator URL to Worker clients.
MIGRATION_TARGET=staging
DATABASE_URL=postgresql://migrator:<password>@<project-branch>.<region>.aws.neon.tech/<database>?sslmode=require
CONFIRM_PRODUCTION_MIGRATION=
CONFIRM_NEON_BACKUP_CHECKED=

# Only use a direct restricted migrator URL here. Worker runtime uses the app role through Hyperdrive.
